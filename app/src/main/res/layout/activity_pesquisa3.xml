<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Pesquisa3Activity">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_marginTop="39dp"
        android:layout_marginEnd="156dp"
        android:src="@drawable/governodobrasil"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="28dp"
        android:text="Nesta etapa, selecione três dos nove aspectos apresentados que você julga mais importantes:"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView3" />

    <CheckBox
        android:id="@+id/cbAF"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:layout_marginTop="25dp"
        android:text="Auxílios Federais"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView3" />

    <CheckBox
        android:id="@+id/cbE"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Educação"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbAF" />

    <CheckBox
        android:id="@+id/cbEst"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Estatizações"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbE" />

    <CheckBox
        android:id="@+id/ckL"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Lazer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbEst" />

    <CheckBox
        android:id="@+id/cbP"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Privatizações"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ckL" />

    <CheckBox
        android:id="@+id/cbSB"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Saneamento Básico "
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbP" />

    <CheckBox
        android:id="@+id/cbSaude"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Saúde"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbSB" />

    <CheckBox
        android:id="@+id/cbSeguranca"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Segurança"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbSaude" />

    <CheckBox
        android:id="@+id/cbT"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginStart="37dp"
        android:text="Transporte"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cbSeguranca" />

    <Button
        android:id="@+id/bt1tela5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="50dp"
        android:text="Próximo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>